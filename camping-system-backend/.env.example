DATABASE_URL="file:./dev.db"
JWT_SECRET="change_this_secret"
PORT=5050

# E-posta bildirimleri (isteğe bağlı) — tanımlanmazsa gönderimler konsola
# loglanır, uygulama çökmez. Gmail için "Uygulama Şifresi" kullanmanız gerekir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampPal <noreply@camppal.com>"

# SMS bildirimleri (isteğe bağlı, Twilio) — tanımlanmazsa gönderimler
# konsola loglanır. Farklı bir sağlayıcı kullanmak isterseniz
# src/services/sms.service.js dosyasını değiştirmeniz yeterli.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
